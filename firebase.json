{
  "hosting": {
    "target": "portal",
    "public": "public",
    "ignore": [
      "firebase.json",
      "**/.*",
      "**/node_modules/**",
      "admin-pwa/**",
      "admin-sw.js",
      "admin.webmanifest",
      "admin-offline.html"
    ],
    "redirects": [
      { "source": "/faq.html", "destination": "/preguntas-frecuentes.html", "type": 301 },
      { "source": "/servicios.html", "destination": "/servicios-lavado.html", "type": 301 },
      { "source": "/guias/", "destination": "/guias.html", "type": 301 },
      { "source": "/guias", "destination": "/guias.html", "type": 301 },
      { "source": "/como-elegir-servicio-de-lavado.html", "destination": "/guias.html", "type": 301 },
      { "source": "/lavado-por-debajo-despues-de-lluvia-santiago.html", "destination": "/guias.html#por-debajo", "type": 301 },
      { "source": "/detailing-interior-vs-lavado-normal.html", "destination": "/guias.html#interior", "type": 301 },
      { "source": "/que-pedir-en-antojos-mientras-esperas.html", "destination": "/guias.html#que-comer", "type": 301 },
      { "source": "/desayuno-dominicano-santiago-mangu-3-golpes.html", "destination": "/guias.html#mangu", "type": 301 },
      { "source": "/admin", "destination": "https://admin.antojosbarlounge.com/admin", "type": 302 },
      { "source": "/admin/**", "destination": "https://admin.antojosbarlounge.com/admin", "type": 302 }
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          { "key": "X-Content-Type-Options", "value": "nosniff" },
          { "key": "Referrer-Policy", "value": "strict-origin-when-cross-origin" },
          { "key": "Strict-Transport-Security", "value": "max-age=31536000; includeSubDomains" }
        ]
      },
      {
        "source": "**/*.html",
        "headers": [{ "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }]
      },
      {
        "source": "/data/*.json",
        "headers": [
          { "key": "Access-Control-Allow-Origin", "value": "*" },
          { "key": "Cache-Control", "value": "public, max-age=60, stale-while-revalidate=300" },
          { "key": "Content-Type", "value": "application/json; charset=utf-8" }
        ]
      },
      {
        "source": "/ads.txt",
        "headers": [
          { "key": "Content-Type", "value": "text/plain; charset=utf-8" },
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      },
      {
        "source": "/sitemap.xml",
        "headers": [
          { "key": "Content-Type", "value": "application/xml; charset=utf-8" },
          { "key": "Cache-Control", "value": "public, max-age=3600" }
        ]
      }
    ]
  }
}
